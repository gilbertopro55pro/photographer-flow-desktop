{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "../dist-electron",
    "resolveJsonModule": true
  },
  "include": ["main.ts", "preload.cts", "browserViewPreload.cts", "psdWriter.ts", "albumMasks.ts", "albumAdjustments.ts", "albumSharpen.ts"]
}
