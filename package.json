{
  "name": "photographer-flow-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Native desktop album design tool for photographer-flow — a separate, standalone app that talks to the same Supabase backend as the web app.",
  "main": "dist-electron/main.js",
  "type": "module",
  "scripts": {
    "renderer:dev": "vite",
    "build:main": "tsc -p electron/tsconfig.json",
    "build": "npm run build:main && vite build",
    "electron:dev": "npm run build:main && DESKTOP_DEV=1 electron .",
    "start": "electron .",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p electron/tsconfig.json"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "@supabase/supabase-js": "^2.45.4",
    "ag-psd": "^31.0.2",
    "pdf-lib": "^1.17.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sharp": "^0.33.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "electron": "^32.0.1",
    "electron-builder": "^25.0.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.5.4",
    "vite": "^5.4.2"
  }
}
